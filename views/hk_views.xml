<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inspection -->
    <record id="view_hk_inspection_list" model="ir.ui.view">
        <field name="name">rmg.hk.inspection.list</field>
        <field name="model">rmg.hk.inspection</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'">
                <field name="name"/>
                <field name="date"/>
                <field name="area_id"/>
                <field name="user_id" optional="show"/>
                <field name="score" optional="show"/>
                <field name="issue_count" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-warning="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_hk_inspection_form" model="ir.ui.view">
        <field name="name">rmg.hk.inspection.form</field>
        <field name="model">rmg.hk.inspection</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_all_ok" string="All OK" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" string="Done" type="object" class="btn-success" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="area_id" options="{'no_create': True, 'no_open': True}" readonly="state == 'done'"/>
                            <field name="template_id" force_save="1" readonly="1"/>
                        </group>
                        <group>
                            <field name="date" readonly="state == 'done'"/>
                            <field name="user_id" readonly="state == 'done'"/>
                            <field name="score" invisible="state != 'done'"/>
                        </group>
                    </group>
                    <field name="line_ids" nolabel="1" readonly="state == 'done'">
                        <list editable="bottom" create="0" delete="0"
                              decoration-success="result == 'ok'" decoration-danger="result == 'no'" decoration-muted="result == 'na'">
                            <field name="state" column_invisible="1"/>
                            <field name="name" readonly="1" force_save="1"/>
                            <field name="critical" readonly="1" optional="hide"/>
                            <field name="result" readonly="1" widget="badge"/>
                            <field name="remark" placeholder="Note (optional)"/>
                            <button name="action_ok" type="object" icon="fa-check" class="text-success" title="OK" invisible="state == 'done'"/>
                            <button name="action_no" type="object" icon="fa-times" class="text-danger" title="Not OK" invisible="state == 'done'"/>
                            <button name="action_na" type="object" icon="fa-minus" class="text-muted" title="N/A" invisible="state == 'done'"/>
                        </list>
                    </field>
                    <field name="note" placeholder="Overall remarks (optional)"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hk_inspection_search" model="ir.ui.view">
        <field name="name">rmg.hk.inspection.search</field>
        <field name="model">rmg.hk.inspection</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="area_id"/>
                <field name="user_id"/>
                <filter name="todo" string="To Do" domain="[('state', '=', 'draft')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="today" string="Today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="mine" string="Mine" domain="[('user_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter name="g_area" string="Area" context="{'group_by': 'area_id'}"/>
                    <filter name="g_date" string="Date" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_hk_inspection_graph" model="ir.ui.view">
        <field name="name">rmg.hk.inspection.graph</field>
        <field name="model">rmg.hk.inspection</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="area_id"/>
                <field name="score" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_hk_inspection_pivot" model="ir.ui.view">
        <field name="name">rmg.hk.inspection.pivot</field>
        <field name="model">rmg.hk.inspection</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="area_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="score" type="measure"/>
                <field name="issue_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_hk_inspection" model="ir.actions.act_window">
        <field name="name">Inspections</field>
        <field name="res_model">rmg.hk.inspection</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="context">{'search_default_todo': 1}</field>
    </record>

    <!-- Issues -->
    <record id="view_hk_issue_list" model="ir.ui.view">
        <field name="name">rmg.hk.issue.list</field>
        <field name="model">rmg.hk.issue</field>
        <field name="arch" type="xml">
            <list decoration-danger="critical and state == 'open'" decoration-muted="state == 'fixed'">
                <field name="name"/>
                <field name="area_id"/>
                <field name="critical"/>
                <field name="user_id"/>
                <field name="date"/>
                <field name="state" widget="badge" decoration-success="state == 'fixed'" decoration-warning="state == 'open'"/>
            </list>
        </field>
    </record>

    <record id="view_hk_issue_form" model="ir.ui.view">
        <field name="name">rmg.hk.issue.form</field>
        <field name="model">rmg.hk.issue</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_fix" string="Mark Fixed" type="object" class="btn-primary" invisible="state != 'open'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="area_id"/>
                            <field name="critical"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="date"/>
                            <field name="fixed_date" invisible="state != 'fixed'"/>
                            <field name="inspection_id" invisible="not inspection_id"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Remarks (optional)"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hk_issue_search" model="ir.ui.view">
        <field name="name">rmg.hk.issue.search</field>
        <field name="model">rmg.hk.issue</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="area_id"/>
                <field name="user_id"/>
                <filter name="open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="fixed" string="Fixed" domain="[('state', '=', 'fixed')]"/>
                <filter name="critical" string="Critical" domain="[('critical', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="g_area" string="Area" context="{'group_by': 'area_id'}"/>
                    <filter name="g_user" string="Responsible" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hk_issue" model="ir.actions.act_window">
        <field name="name">Issues</field>
        <field name="res_model">rmg.hk.issue</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>

    <!-- Areas (inline editable) -->
    <record id="view_hk_area_list" model="ir.ui.view">
        <field name="name">rmg.hk.area.list</field>
        <field name="model">rmg.hk.area</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="template_id" options="{'no_create': True}"/>
                <field name="frequency"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="action_hk_area" model="ir.actions.act_window">
        <field name="name">Areas</field>
        <field name="res_model">rmg.hk.area</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Checklists -->
    <record id="view_hk_template_list" model="ir.ui.view">
        <field name="name">rmg.hk.template.list</field>
        <field name="model">rmg.hk.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_hk_template_form" model="ir.ui.view">
        <field name="name">rmg.hk.template.form</field>
        <field name="model">rmg.hk.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group><field name="name"/></group>
                    <field name="item_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="critical"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hk_template" model="ir.actions.act_window">
        <field name="name">Checklists</field>
        <field name="res_model">rmg.hk.template</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
