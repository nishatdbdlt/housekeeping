<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_hk_inspection" model="ir.sequence">
        <field name="name">Housekeeping Inspection</field>
        <field name="code">rmg.hk.inspection</field>
        <field name="prefix">HK/%(year)s/</field>
        <field name="padding">4</field>
    </record>
    <record id="cron_hk_generate" model="ir.cron">
        <field name="name">Housekeeping: create scheduled inspections</field>
        <field name="model_id" ref="model_rmg_hk_inspection"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_inspections()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
