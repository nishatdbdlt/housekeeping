<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_rmg_housekeeping" model="ir.module.category">
        <field name="name">Housekeeping</field>
    </record>
    <record id="group_hk_user" model="res.groups">
        <field name="name">Inspector</field>
        <field name="category_id" ref="module_category_rmg_housekeeping"/>
    </record>
    <record id="group_hk_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_rmg_housekeeping"/>
        <field name="implied_ids" eval="[(4, ref('group_hk_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
